# /etc/oi-laya/token.env  (root:root, chmod 0600). Put a token on the line below, generated with:
#   openssl rand -base64 32
# The proxy refuses to start while it is empty, shorter than 32 characters or a placeholder.
# Then, on the Mac:  oi laya-remote enable --url http://__PRIVATE_ADDR__:8781   (it asks for this token)
OI_LAYA_TOKEN=
